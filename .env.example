# Generer avec : python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1
DRF_PAGE_SIZE=20
DRF_THROTTLE_ANON=60/minute
DRF_THROTTLE_USER=240/minute
DB_NAME=kotiza_db
DB_USER=kotiza_user
DB_PASSWORD=ChangeMe_2025!
DB_HOST=localhost
DB_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Email (optionnel) : laisser vide en dev = emails ecrits dans la console/les logs.
# Definir EMAIL_HOST pour activer un vrai envoi SMTP en production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@kotiza.local

# Sentry (suivi des erreurs) : laisser vide pour desactiver
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Abonnement (installation par client, cf. DEPLOYMENT-CLIENTS.md) : vide = aucune limite
KOTIZA_ACCESS_UNTIL=
KOTIZA_BILLING_CONTACT=
# Votre email : recoit les demandes de devis (sinon elles restent seulement dans l admin)
KOTIZA_SALES_EMAIL=
# API REST (/api/) : desactivee par defaut, 1 pour l activer
KOTIZA_API_ENABLED=0
KOTIZA_CURRENCY=FCFA
# Tarifs mensuels affiches sur la page Devis et duree de l essai gratuit (jours)
KOTIZA_PRICE_STARTER=15000
KOTIZA_PRICE_BUSINESS=35000
KOTIZA_TRIAL_DAYS=30
# Adresse publique du site, utilisee dans les liens des SMS / WhatsApp
KOTIZA_SITE_URL=
KOTIZA_DEFAULT_COUNTRY_CODE=228

# PayGate Global (Mobile Money T-Money / Flooz) : cle API du compte marchand
# paygateglobal.com. Vide = paiement en ligne desactive.
# Dans l'espace marchand, declarer l'URL de retour : https://<votre-site>/webhooks/paygate/
PAYGATE_AUTH_TOKEN=

# SMS via eSMS Africa (esmsafrica.io) : cle esms_live_... (Developers > API Keys).
# Prioritaire sur Twilio pour les SMS. ESMS_SENDER_ID = nom d expediteur approuve.
ESMS_API_KEY=
ESMS_SENDER_ID=

# Rappels SMS / WhatsApp (Twilio). Vide = messages seulement journalises.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero Twilio d'envoi des SMS, ex. +15551234567
TWILIO_SMS_FROM=
# Numero WhatsApp Business valide, ex. whatsapp:+15551234567
TWILIO_WHATSAPP_FROM=
# Modele WhatsApp valide par Meta (ContentSid HX...), variables {{1}} nom,
# {{2}} groupe, {{3}} mois, {{4}} lien de paiement. Sans modele, WhatsApp
# refuse les rappels et le SMS prend le relais.
TWILIO_WHATSAPP_TEMPLATE_SID=
